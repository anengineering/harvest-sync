# Copy to .env (git ignores it) and fill in. Real environment variables take precedence.
# Create each token at https://id.getharvest.com/developers while signed in as the matching Harvest ID.

# Token for your own Harvest ID
HARVEST_SOURCE_TOKEN=

# Token for the Harvest ID the client created for you
HARVEST_DEST_TOKEN=

# Your Mailgun API key, only if you've set up the optional [email] section in config.toml
# HARVEST_MAILGUN_API_KEY=
